{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend/predictor-app && npm ci && npm run build",
  "outputDirectory": "frontend/predictor-app/dist",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{ml/**,frontend/**,**/*.ipynb,**/*.sav,**/*.csv,**/*.png,**/*.parquet,**/__pycache__/**,**/.ipynb_checkpoints/**}"
    },
    "api/predict.py": {
      "includeFiles": "api/models/lightgbm.joblib"
    }
  }
}
